{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-feature-delivery:schema:change-coverage-policy:v1",
  "title": "Feature Delivery change coverage policy",
  "type": "object",
  "required": ["schema_version", "kind", "repository_id", "feature_root", "required_gate", "protected_paths", "exemptions"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "FeatureChangeCoveragePolicy" },
    "repository_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
    "feature_root": { "$ref": "#/$defs/repositoryPath" },
    "required_gate": { "enum": ["G3", "G4"] },
    "protected_paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/protectedPath" }
    },
    "exemptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exemption" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!(?:.*\\/)?(?:\\.{1,2}|\\.git)(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "protectedPath": {
      "type": "object",
      "required": ["path", "match", "mode"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "match": { "enum": ["exact", "prefix"] },
        "mode": { "enum": ["exemption_only", "controlled_g4_or_exemption", "external_digest_only"] }
      },
      "additionalProperties": false
    },
    "exemption": {
      "type": "object",
      "required": ["id", "owner", "rationale", "approval_reference", "created_at", "expires_at", "one_time", "changed_files", "head_content_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "approval_reference": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "one_time": { "const": true },
        "changed_files": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "head_content_digest": { "$ref": "#/$defs/digest" }
      },
      "additionalProperties": false
    }
  }
}
