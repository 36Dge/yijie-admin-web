{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:codex-feature-delivery:schema:feature-package:v2",
  "title": "Codex Feature Delivery v2 package records",
  "oneOf": [
    { "$ref": "#/$defs/featurePackage" },
    { "$ref": "#/$defs/evidenceLedger" },
    { "$ref": "#/$defs/decisionLedger" }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "anyOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
    },
    "sha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "nullableSha": {
      "anyOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }]
    },
    "repositoryScopePath": {
      "type": "string",
      "pattern": "^(?:\\.|(?!(?:.*\\/)?(?:\\.{1,2}|\\.git)(?:\\/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "authorizationCapability": {
      "enum": ["workspace_read", "workspace_edit", "local_command", "local_test", "local_build", "dependency_install", "network_read", "external_write", "real_sensitive_data", "paid_call", "deployment", "migration", "irreversible_operation"]
    },
    "featurePackage": {
      "type": "object",
      "required": ["schema_version", "kind", "policy", "feature", "classification", "size", "acceptance_criteria", "repositories", "dependencies", "boundaries", "slices", "artifacts"],
      "properties": {
        "schema_version": { "const": 2 },
        "kind": { "const": "FeaturePackage" },
        "policy": {
          "type": "object",
          "required": ["id", "version", "digest"],
          "properties": {
            "id": { "const": "codex-feature-delivery/v2" },
            "version": { "type": "string", "pattern": "^2\\." },
            "digest": { "$ref": "#/$defs/digest" }
          },
          "additionalProperties": false
        },
        "feature": {
          "type": "object",
          "required": ["id", "slug", "title", "summary", "lifecycle", "profile", "delivery_target", "created_at", "updated_at", "owners"],
          "properties": {
            "id": { "type": "string", "pattern": "^FEAT-[A-Z0-9][A-Z0-9.-]*$" },
            "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
            "title": { "type": "string", "minLength": 1 },
            "summary": { "type": "string", "minLength": 1 },
            "lifecycle": { "enum": ["proposed", "active", "blocked", "completed", "cancelled"] },
            "profile": { "enum": ["lite", "standard", "controlled"] },
            "delivery_target": { "enum": ["local_engineering", "staging", "production"] },
            "created_at": { "type": "string" },
            "updated_at": { "type": "string" },
            "owners": {
              "type": "object",
              "required": ["accountable", "role_assignments"],
              "properties": {
                "accountable": { "type": "string", "minLength": 1 },
                "role_assignments": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": ["actor", "roles"],
                    "properties": {
                      "actor": { "type": "string", "minLength": 1 },
                      "roles": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "classification": {
          "type": "object",
          "required": ["risk", "data", "risk_factors"],
          "properties": {
            "risk": { "enum": ["low", "medium", "high", "critical"] },
            "data": { "enum": ["public", "internal", "confidential", "restricted"] },
            "risk_factors": {
              "type": "array",
              "items": {
                "enum": [
                  "contract_breaking",
                  "database_migration",
                  "restricted_data",
                  "irreversible_operation",
                  "regulated_data",
                  "production_security_boundary",
                  "contract_change",
                  "external_side_effect",
                  "ai_behavior_change",
                  "public_unknown_consumers"
                ]
              },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "size": {
          "type": "object",
          "required": ["class", "repositories", "boundaries", "acceptance_criteria", "slices", "estimated_active_days"],
          "properties": {
            "class": { "enum": ["small", "medium", "large"] },
            "repositories": { "type": "integer", "minimum": 1 },
            "boundaries": { "type": "integer", "minimum": 0 },
            "acceptance_criteria": { "type": "integer", "minimum": 1 },
            "slices": { "type": "integer", "minimum": 1 },
            "estimated_active_days": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        },
        "acceptance_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "statement"],
            "properties": {
              "id": { "type": "string", "pattern": "^AC-[0-9]{3,}$" },
              "statement": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "identity", "path", "root_scope_justification", "root_scope_exception_evidence_id", "role", "baseline"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" },
              "identity": {
                "type": "object",
                "required": ["kind", "name", "url", "root"],
                "properties": {
                  "kind": { "enum": ["current", "managed", "external"] },
                  "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
                  "url": { "type": "string", "pattern": "^[^\\s\\x00]+$" },
                  "root": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              },
              "path": { "$ref": "#/$defs/repositoryScopePath" },
              "root_scope_justification": { "type": ["string", "null"] },
              "root_scope_exception_evidence_id": { "type": ["string", "null"] },
              "role": { "type": "string", "minLength": 1 },
              "baseline": {
                "type": "object",
                "required": ["sha", "evidence_id"],
                "properties": {
                  "sha": { "$ref": "#/$defs/nullableSha" },
                  "evidence_id": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "status", "owner", "evidence_id"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "type": { "enum": ["feature", "repository", "service", "environment", "decision", "external"] },
              "status": { "enum": ["unresolved", "resolved", "waived"] },
              "owner": { "type": "string", "minLength": 1 },
              "evidence_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "impact", "owner", "authority", "producers", "consumers", "known_unknowns", "artifact_id"],
            "properties": {
              "id": { "type": "string", "pattern": "^BND-[0-9]{3,}$" },
              "type": { "enum": ["generated_schema", "handwritten_protocol", "database_format", "runtime_third_party", "semantic_only"] },
              "impact": { "enum": ["additive", "semantic", "breaking"] },
              "owner": { "type": "string", "minLength": 1 },
              "authority": { "type": "string", "minLength": 1 },
              "producers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "consumers": { "type": "array", "items": { "type": "string" } },
              "known_unknowns": { "type": "array", "items": { "type": "string" } },
              "artifact_id": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "slices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "title", "outcome", "depends_on", "boundary_ids", "acceptance_criteria", "repositories", "paths", "authorization_decision_id"],
            "properties": {
              "id": { "type": "string", "pattern": "^SLC-[0-9]{3,}$" },
              "title": { "type": "string", "minLength": 1 },
              "outcome": { "type": "string", "minLength": 1 },
              "depends_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "boundary_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "acceptance_criteria": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
              "repositories": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
              "paths": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "object",
                  "required": ["repository", "path"],
                  "properties": {
                    "repository": { "type": "string", "minLength": 1 },
                    "path": { "$ref": "#/$defs/repositoryScopePath" }
                  },
                  "additionalProperties": false
                }
              },
              "authorization_decision_id": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "kind", "path", "authority", "applicability", "reason"],
            "properties": {
              "id": { "type": "string", "pattern": "^ART-[A-Z0-9-]+$" },
              "kind": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "authority": { "enum": ["normative", "index", "summary", "operational"] },
              "applicability": { "enum": ["required", "conditional", "not_applicable"] },
              "reason": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "evidenceLedger": {
      "type": "object",
      "required": ["schema_version", "kind", "feature_id", "entries"],
      "properties": {
        "schema_version": { "const": 2 },
        "kind": { "const": "EvidenceLedger" },
        "feature_id": { "type": "string" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "recorded_at", "producer", "subject", "execution", "artifacts", "notes"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "kind": { "enum": ["baseline", "dependency_probe", "boundary_validation", "unit_test", "integration_test", "contract_test", "e2e_test", "ai_eval", "static_analysis", "build", "review", "security_review", "data_review", "release_artifact", "rollback_rehearsal", "release_execution", "smoke", "observation", "owner_acceptance", "outcome_metric", "exception"] },
              "recorded_at": { "type": "string", "format": "date-time" },
              "producer": {
                "type": "object",
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "type": { "enum": ["human", "ci", "codex", "tool", "system"] }
                },
                "additionalProperties": false
              },
              "subject": {
                "type": "object",
                "required": ["instance", "repository", "cwd", "code_sha", "base_sha", "environment_ref", "account_ref", "artifact_refs", "acceptance_criteria"],
                "properties": {
                  "instance": { "type": "string" },
                  "repository": { "type": ["string", "null"] },
                  "cwd": { "type": ["string", "null"] },
                  "code_sha": { "$ref": "#/$defs/nullableSha" },
                  "base_sha": { "$ref": "#/$defs/nullableSha" },
                  "environment_ref": { "type": ["string", "null"] },
                  "account_ref": { "type": ["string", "null"] },
                  "artifact_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "digest"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "digest": { "$ref": "#/$defs/digest" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "acceptance_criteria": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                },
                "additionalProperties": true
              },
              "execution": {
                "type": "object",
                "required": ["command", "tool", "tool_version", "started_at", "finished_at", "exit_code", "result"],
                "properties": {
                  "command": { "type": "string", "minLength": 1 },
                  "tool": { "type": "string", "minLength": 1 },
                  "tool_version": { "type": "string", "minLength": 1 },
                  "started_at": { "type": "string", "format": "date-time" },
                  "finished_at": { "type": "string", "format": "date-time" },
                  "exit_code": { "type": "integer" },
                  "result": { "enum": ["passed", "failed", "not_run"] }
                },
                "additionalProperties": false
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["uri", "digest", "retention_until"],
                  "properties": {
                    "uri": { "type": "string", "minLength": 1 },
                    "digest": { "$ref": "#/$defs/digest" },
                    "retention_until": { "type": "string", "format": "date-time" }
                  },
                  "additionalProperties": false
                }
              },
              "notes": { "type": "string" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "decisionLedger": {
      "type": "object",
      "required": ["schema_version", "kind", "feature_id", "entries"],
      "properties": {
        "schema_version": { "const": 2 },
        "kind": { "const": "GateDecisionLedger" },
        "feature_id": { "type": "string" },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "sequence", "gate", "instance", "state", "actor", "roles", "decided_at", "valid_until", "subject", "evidence_refs", "authorization", "attestation", "rationale", "supersedes"],
            "properties": {
              "id": { "type": "string" },
              "sequence": { "type": "integer", "minimum": 1 },
              "gate": { "enum": ["G0", "G1", "G2", "G2C", "G3", "G4", "G5", "G6"] },
              "instance": { "type": "string" },
              "state": { "enum": ["blocked", "ready", "in_review", "passed", "failed", "stale"] },
              "actor": {
                "type": "object",
                "required": ["id", "type"],
                "properties": {
                  "id": { "type": "string", "minLength": 1 },
                  "type": { "enum": ["human", "ci", "codex", "tool", "system"] }
                },
                "additionalProperties": false
              },
              "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
              "decided_at": { "type": "string", "format": "date-time" },
              "valid_until": { "type": ["string", "null"], "format": "date-time" },
              "subject": {
                "type": "object",
                "required": ["policy_digest", "declaration_digest", "intake_digest", "scope_digest", "build_digest", "boundary_digest", "slice_digest", "engineering_digest", "release_digest", "spec_digest", "code_refs", "artifact_refs", "engineering_decision_ref", "environment_ref", "account_ref", "rollback_ref"],
                "properties": {
                  "policy_digest": { "$ref": "#/$defs/nullableDigest" },
                  "declaration_digest": { "$ref": "#/$defs/nullableDigest" },
                  "intake_digest": { "$ref": "#/$defs/nullableDigest" },
                  "scope_digest": { "$ref": "#/$defs/nullableDigest" },
                  "build_digest": { "$ref": "#/$defs/nullableDigest" },
                  "boundary_digest": { "$ref": "#/$defs/nullableDigest" },
                  "slice_digest": { "$ref": "#/$defs/nullableDigest" },
                  "engineering_digest": { "$ref": "#/$defs/nullableDigest" },
                  "release_digest": { "$ref": "#/$defs/nullableDigest" },
                  "spec_digest": { "$ref": "#/$defs/nullableDigest" },
                  "code_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["repository", "sha", "base_sha"],
                      "properties": {
                        "repository": { "type": "string", "minLength": 1 },
                        "sha": { "$ref": "#/$defs/sha" },
                        "base_sha": { "$ref": "#/$defs/sha" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "artifact_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "digest"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "digest": { "$ref": "#/$defs/digest" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "engineering_decision_ref": {
                    "oneOf": [
                      { "type": "null" },
                      {
                        "type": "object",
                        "required": ["id", "digest"],
                        "properties": {
                          "id": { "type": "string", "minLength": 1 },
                          "digest": { "$ref": "#/$defs/digest" }
                        },
                        "additionalProperties": false
                      }
                    ]
                  },
                  "environment_ref": { "type": ["string", "null"] },
                  "account_ref": { "type": ["string", "null"] },
                  "rollback_ref": { "type": ["string", "null"] }
                },
                "additionalProperties": false
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "digest"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "digest": { "$ref": "#/$defs/digest" }
                  },
                  "additionalProperties": false
                }
              },
              "authorization": {
                "type": "object",
                "required": ["instances", "repositories", "paths", "base_refs", "environment", "account", "data_classification", "budget", "allowed_actions", "excluded_actions", "stop_conditions", "required_evidence", "reauthorize_on"],
                "properties": {
                  "instances": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "repositories": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "paths": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "type": "object",
                      "required": ["repository", "path"],
                      "properties": {
                        "repository": { "type": "string", "minLength": 1 },
                        "path": { "$ref": "#/$defs/repositoryScopePath" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "base_refs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["repository", "sha"],
                      "properties": {
                        "repository": { "type": "string", "minLength": 1 },
                        "sha": { "$ref": "#/$defs/sha" }
                      },
                      "additionalProperties": false
                    }
                  },
                  "environment": { "type": ["string", "null"] },
                  "account": { "type": ["string", "null"] },
                  "data_classification": { "type": ["string", "null"] },
                  "budget": {
                    "type": "object",
                    "required": ["currency", "maximum"],
                    "properties": {
                      "currency": { "type": ["string", "null"] },
                      "maximum": { "type": ["number", "null"], "minimum": 0 }
                    },
                    "additionalProperties": false
                  },
                  "allowed_actions": { "type": "array", "items": { "$ref": "#/$defs/authorizationCapability" }, "uniqueItems": true },
                  "excluded_actions": { "type": "array", "items": { "$ref": "#/$defs/authorizationCapability" }, "uniqueItems": true },
                  "stop_conditions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "required_evidence": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
                  "reauthorize_on": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
                },
                "additionalProperties": false
              },
              "attestation": {
                "anyOf": [
                  { "type": "null" },
                  {
                    "type": "object",
                    "required": ["scheme", "key_id", "payload_digest", "signature"],
                    "properties": {
                      "scheme": { "const": "ed25519-v1" },
                      "key_id": { "type": "string", "minLength": 1 },
                      "payload_digest": { "$ref": "#/$defs/digest" },
                      "signature": { "type": "string", "minLength": 1, "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$" }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "rationale": { "type": "string", "minLength": 1 },
              "supersedes": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
